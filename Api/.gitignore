# ==========================================
# Dependencias de PHP (Composer)
# ==========================================
/vendor/

# ==========================================
# Archivos de Entorno y Configuración Sensible
# ==========================================
.env
.env.*
!.env.example
src/Config/database.local.php
config/settings.local.php

# ==========================================
# Logs y Archivos Temporales de la Aplicación
# ==========================================
/logs/*
!/logs/.gitkeep
/tmp/*
!/tmp/.gitkeep
/cache/*
!/cache/.gitkeep
/var/cache/*
/var/logs/*

# ==========================================
# IDEs, Editores de Código y Sistema Operativo
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# PhpStorm / JetBrains
.idea/
*.iml

# OS (macOS & Windows)
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ==========================================
# Pruebas Unitarias y Cobertura (PHPUnit)
# ==========================================
/.phpunit.cache
/coverage/
.php-cs-fixer.cache
phpunit.xml.bak

# ==========================================
# Servidor Web / Archivos de Certificados
# ==========================================
*.pem
*.key
*.crt